{
  "name": "g-tool",
  "version": "1.0.0",
  "private": true,
  "description": "G-tool: multi-tool web app with Express API and React frontend",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "start": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install"
  },
  "keywords": [
    "toolbox",
    "express",
    "react",
    "vite",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "msgpack-lite": "^0.1.26",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "systeminformation": "^5.31.5",
    "tesseract.js": "^5.0.4",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
