# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables.

# Local server port (ignored on Vercel)
PORT=5000

# Google Gemini (required for Translate, SQL AI, Color AI, Regex AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# CORS: main client origin, plus optional comma-separated extra origins
CLIENT_URL=http://localhost:5173
CLIENT_URLS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Set to 1 when running behind a proxy (Vercel) so rate limiting sees the real client IP
TRUST_PROXY=
